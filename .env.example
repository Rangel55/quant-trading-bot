# =================================================================
# QUANT TRADING BOT - Variaveis de Ambiente
# ETAPA 2: Configuracao Segura da API Binance
# =================================================================
#
# INSTRUCOES DE CONFIGURACAO:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha com suas chaves reais
# 3. NUNCA commite o arquivo .env (ja esta no .gitignore)
# 4. NUNCA compartilhe suas chaves com ninguem
#
# ONDE CRIAR SUA API KEY:
# https://www.binance.com/en/my/settings/api-management
#
# PERMISSOES OBRIGATORIAS (marcar):
#   [x] Enable Reading         <- necessario para dados de mercado
#   [x] Enable Spot & Margin Trading <- necessario para ordens
#
# PERMISSOES PROIBIDAS (NUNCA marcar):
#   [ ] Enable Withdrawals     <- PERIGO: permite sacar seus fundos!
#   [ ] Enable Futures         <- nao usar neste bot
#   [ ] Enable Margin          <- nao usar neste bot
#
# RESTRICAO DE IP (FORTEMENTE RECOMENDADO):
#   - Na criacao da API, selecione "Restrict access to trusted IPs only"
#   - Adicione o IP do servidor onde o bot vai rodar
#   - Isso impede uso da chave mesmo que ela seja vazada
# =================================================================

# --- CHAVES DE API BINANCE ---
# Cole aqui suas chaves (sem aspas)
BINANCE_API_KEY=cole_sua_api_key_aqui
BINANCE_API_SECRET=cole_seu_api_secret_aqui

# --- PAR DE TRADING ---
# Par que o bot vai operar. Exemplos: BTCUSDT, ETHUSDT, BNBUSDT
SYMBOL=BTCUSDT

# --- CAPITAL DISPONIVEL (em USDT) ---
# Quanto voce quer deixar disponivel para o bot operar
# O bot usara no maximo 2% deste valor por trade
CAPITAL_USDT=100

# --- MODO DE EXECUCAO ---
# true  = DRY RUN (simulacao, RECOMENDADO para comecar)
# false = LIVE (executa ordens reais na Binance)
# AVISO: So mude para false apos testar por pelo menos 2 semanas!
DRY_RUN=true
