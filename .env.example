# ByBit API - Futuros (Linear/USDT-Perp)
# Obtenha suas chaves em: https://www.bybit.com/app/user/api-management
BYBIT_API_KEY=sua_api_key_aqui
BYBIT_API_SECRET=seu_api_secret_aqui

# Modo de operacao
# DRY_RUN=true  -> Simula operacoes sem executar ordens reais
# DRY_RUN=false -> Executa ordens reais nos Futuros ByBit
DRY_RUN=true

# Alavancagem (padrao: 10x)
LEVERAGE=10

# Porta do servidor web (dashboard)
PORT=3000
