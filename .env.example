# QUANT TRADING BOT - Futures Binance
# Copie: cp .env.example .env e preencha com suas chaves

# --- CHAVES DE API BINANCE ---
BINANCE_API_KEY=cole_sua_api_key_aqui
BINANCE_API_SECRET=cole_seu_api_secret_aqui

# --- PAR PADRAO ---
SYMBOL=BTCUSDT

# --- CAPITAL EM USDT NA CONTA FUTURES ---
CAPITAL_USDT=20

# --- ALAVANCAGEM (5x recomendado para iniciantes) ---
LEVERAGE=5

# --- MODO ---
# true = simulacao | false = LIVE com dinheiro real
DRY_RUN=true
