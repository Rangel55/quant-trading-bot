# ============================================================
#  QUANT TRADING BOT - ByBit Futures
#  Copie este arquivo para .env e preencha com seus valores
#  cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# BYBIT API - Futuros Linear (USDT-Perp)
# Gere em: https://www.bybit.com/app/user/api-management
# Permissoes necessarias: Contract - Read e Write
# IMPORTANTE: Use IP de fora do Brasil (bloqueia acesso a futuros)
# ------------------------------------------------------------
BYBIT_API_KEY=sua_api_key_aqui
BYBIT_API_SECRET=seu_api_secret_aqui

# ------------------------------------------------------------
# MODO DE OPERACAO
# DRY_RUN=true  -> Simula ordens sem capital real (recomendado para testes)
# DRY_RUN=false -> Executa ordens reais nos Futuros ByBit
# ------------------------------------------------------------
DRY_RUN=true

# ------------------------------------------------------------
# CAPITAL E ALAVANCAGEM
# ------------------------------------------------------------
CAPITAL_USDT=20
LEVERAGE=10
MARGIN_TYPE=ISOLATED

# ------------------------------------------------------------
# PAR DE TRADING PADRAO
# ------------------------------------------------------------
SYMBOL=BTCUSDT

# ------------------------------------------------------------
# STOP LOSS E TAKE PROFIT (em %)
# Ex: 0.015 = 1.5%
# ------------------------------------------------------------
STOP_LOSS_PERCENT=0.015
TAKE_PROFIT_PERCENT=0.04

# ------------------------------------------------------------
# TRAILING STOP
# TRAILING_STOP=true ativa o trailing (substitui o SL fixo)
# TRAILING_STOP_PERCENT: distancia do trailing em % do preco de entrada
# Ex: 0.01 = 1% de distancia
# ------------------------------------------------------------
TRAILING_STOP=false
TRAILING_STOP_PERCENT=0.01

# ------------------------------------------------------------
# FILTROS DE ENTRADA DO SCANNER
# ------------------------------------------------------------
MIN_VOLUME_24H=5000000
MIN_CHANGE_24H=0.1
MIN_VOLATILITY=0.001

# ------------------------------------------------------------
# GESTAO DE RISCO
# ------------------------------------------------------------
MAX_POSITION_PERCENT=0.90
MAX_DAILY_TRADES=50

# ------------------------------------------------------------
# INDICADORES TECNICOS
# ------------------------------------------------------------
MA_FAST=9
MA_SLOW=21
MA_TREND=200
RSI_PERIOD=14
RSI_OVERBOUGHT=75
RSI_OVERSOLD=25

# ------------------------------------------------------------
# INTERVALO DE ANALISE (em milissegundos)
# 30000 = 30 segundos
# ------------------------------------------------------------
ANALYSIS_INTERVAL_MS=30000

# ------------------------------------------------------------
# PROXY (para operar fora do Brasil via servidor externo)
# Deixe em branco se ja esta rodando em servidor com IP externo
# PROXY_PROTOCOL: http ou socks5
# ------------------------------------------------------------
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
PROXY_PROTOCOL=http

# ------------------------------------------------------------
# SERVIDOR WEB (dashboard)
# ------------------------------------------------------------
PORT=3000

# ------------------------------------------------------------
# ESTADO PERSISTENTE (arquivo onde o bot salva a posicao aberta)
# Nao alterar a menos que necessario
# ------------------------------------------------------------
STATE_FILE=./logs/bot_state.json
